---
import Base from '../../layouts/Base.astro';
import BookCover from '../../components/BookCover.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import MemberScore from '../../components/MemberScore.astro';
import { getBooks, getBookBySlug, ratingsLabel } from '../../data/books';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return getBooks().map((book) => ({ params: { slug: book.slug } }));
}

const { slug } = Astro.params;
const book = getBookBySlug(slug!);
if (!book) throw new Error(`Nie znaleziono książki dla slug: ${slug}`);
---

<Base title={`${book.title} — Klub Książki`}>
  <main class="container detail">
    <a class="back" href={url('/')}>← Powrót do rankingu</a>

    <article class="hero">
      <div class="cover-col">
        <BookCover
          slug={book.slug}
          title={book.title}
          author={book.author}
          variant="full"
        />
      </div>

      <div class="info-col">
        <h1 class="book-title">{book.title}</h1>
        <p class="book-author">{book.author ? book.author : 'Autor nieznany'}</p>

        {
          book.categories.length > 0 && (
            <ul class="cats" aria-label="Kategorie">
              {book.categories.map((c) => (
                <li class="cat">{c}</li>
              ))}
            </ul>
          )
        }

        <div class="avg-block">
          {
            book.average !== null ? (
              <>
                <ScoreBadge value={book.average} label={book.averageLabel} size="lg" />
                <span class="avg-caption">
                  średnia ocena
                  <br />
                  <span class="avg-count">z {book.ratingsCount} {ratingsLabel(book.ratingsCount)}</span>
                </span>
              </>
            ) : (
              <span class="avg-caption">Brak ocen</span>
            )
          }
        </div>
      </div>
    </article>

    {
      book.description && (
        <section class="desc" aria-labelledby="desc-heading">
          <h2 id="desc-heading" class="desc-title">Opis</h2>
          <p class="desc-text">{book.description}</p>
          <p class="desc-src">Opis i kategorie: Google Books / Open Library</p>
        </section>
      )
    }

    <section class="scores" aria-labelledby="scores-heading">
      <h2 id="scores-heading" class="scores-title">Oceny członków</h2>
      <ol class="member-list" role="list">
        {
          [...book.scores]
            .sort((a, b) => (b.score ?? -1) - (a.score ?? -1))
            .map((m) => <MemberScore name={m.name} score={m.score} />)
        }
      </ol>
    </section>
  </main>

  <footer class="site-footer container">
    <hr class="divider" />
    <p><a class="foot-link" href={url('/')}>← Powrót do rankingu</a></p>
  </footer>
</Base>

<style>
  .detail {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .back {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }
  .back:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 240px) 1fr;
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }
  .cover-col {
    width: 100%;
    max-width: 240px;
  }
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.25rem;
  }
  .book-title {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }
  .book-author {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }
  .cats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
  }
  .cat {
    font-size: 0.78rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
  }
  .desc {
    margin-top: clamp(2rem, 6vw, 3rem);
    max-width: 42rem;
  }
  .desc-title {
    font-size: 1.4rem;
    margin-bottom: 0.6rem;
  }
  .desc-text {
    margin: 0;
    line-height: 1.7;
    white-space: pre-line;
  }
  .desc-src {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .avg-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .avg-caption {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .avg-count {
    font-weight: 600;
    color: var(--ink);
  }

  .scores {
    margin-top: clamp(2.5rem, 7vw, 4rem);
    max-width: 34rem;
  }
  .scores-title {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--line-strong);
  }
  .member-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot-link {
    font-weight: 600;
    color: var(--muted);
  }
  .foot-link:hover {
    color: var(--ink);
  }

  @media (max-width: 34rem) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .cover-col {
      max-width: 200px;
    }
    .info-col {
      align-items: center;
    }
    .avg-block {
      justify-content: center;
    }
    .cats {
      justify-content: center;
    }
  }
</style>
