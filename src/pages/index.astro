---
import Base from '../layouts/Base.astro';
import BookRow from '../components/BookRow.astro';
import BookCover from '../components/BookCover.astro';
import ProviderTag from '../components/ProviderTag.astro';
import { getBooks } from '../data/books';
import { getNextMeeting } from '../data/next-meeting';

const books = getBooks();
const count = books.length;

// Set by email or `npm run next` — see src/data/next-meeting.json.
const nextMeeting = getNextMeeting();
---

<Base title="Klub Książki — Ranking">
  <header class="site-header container">
    <p class="eyebrow">Ranking przeczytanych książek</p>
    <h1 class="site-title">Podziemny Klub Książki</h1>
  </header>

  <main class="container">
    {nextMeeting && <div class="next-meeting-section">
      <div class="next-meeting-book">
        <div class="next-meeting-row">
          <div class="next-meeting-link">
            <span class="next-meeting-rank" aria-hidden="true">→</span>
            <div class="next-meeting-cover">
              <BookCover slug={nextMeeting.cover} title={nextMeeting.title} author={nextMeeting.author} variant="thumb" />
              <span class="next-meeting-label">Następne spotkanie</span>
            </div>
            <span class="next-meeting-meta">
              <span class="next-meeting-title">{nextMeeting.title}</span>
              <span class="next-meeting-sub">{nextMeeting.author}</span>
              <div class="provider-tags">
                {nextMeeting.providers.map((provider) => <ProviderTag provider={provider} />)}
              </div>
            </span>
            <span class="next-meeting-date">
              <span class="next-meeting-date-day">{nextMeeting.date}</span>
              <span class="next-meeting-date-time">{nextMeeting.time}</span>
            </span>
          </div>
        </div>
      </div>
    </div>}
    
    <p class="next-meeting-text">Wszystkie {count} książek, które razem przeczytaliśmy:</p>
    
    <ol class="leaderboard" role="list">
      {books.map((book, i) => <BookRow book={book} rank={i + 1} />)}
    </ol>
  </main>

  <footer class="site-footer container">
    <hr class="divider" />
    <p>Średnia liczona z ocen członków. Kliknij książkę, aby zobaczyć szczegóły.</p>
  </footer>
</Base>

<style>
  .leaderboard {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .site-footer .divider {
    margin-bottom: 1.5rem;
  }
  
  .next-meeting-section {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  
  .next-meeting-text {
    text-align: center;
    color: var(--muted);
    margin: 2rem 0 1.5rem;
    font-size: 1.1rem;
  }
  
  .next-meeting-book {
    opacity: 0.9;
  }
  
  .next-meeting-row {
    list-style: none;
  }
  
  .next-meeting-link {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    padding: 0.75rem clamp(0.75rem, 2.5vw, 1.25rem);
    background: rgba(63, 107, 83, 0.05);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
  }

  .next-meeting-rank {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--accent);
    min-width: 1.6rem;
    text-align: center;
    font-weight: 600;
  }
  
  .next-meeting-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
    justify-content: center;
    max-width: calc(100% - 8rem); /* Prevent meta from taking too much space */
  }
  
  .next-meeting-title {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
  
  .next-meeting-sub {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .next-meeting-date {
    align-self: center;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 5.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .next-meeting-date-day {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .next-meeting-date-time {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* The tags themselves live in ProviderTag.astro; this only lays them out. */
  .provider-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.35rem;
  }

  .next-meeting-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  
  .next-meeting-label {
    font-size: 0.7rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.2;
  }
</style>
