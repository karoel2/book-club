---
import Base from '../../layouts/Base.astro';
import BookRow from '../../components/BookRow.astro';
import { getMembers, getMemberBySlug, getMemberRatings, booksLabel } from '../../data/books';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return getMembers().map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const member = getMemberBySlug(slug!);
if (!member) throw new Error(`Nie znaleziono członka dla slug: ${slug}`);

const ratings = getMemberRatings(member.name);
---

<Base title={`${member.name} — oceny — Klub Książki`}>
  <header class="site-header container">
    <p class="eyebrow"><a class="crumb" href={url('/')}>Klub Książki</a> · oceny członka</p>
    <h1 class="site-title">{member.name}</h1>
    <p class="site-tagline">
      {member.ratedCount} {booksLabel(member.ratedCount)} · średnia wystawiana ocena {member.averageLabel}
    </p>
  </header>

  <main class="container">
    <ol class="leaderboard" role="list">
      {
        ratings.map((r, i) => (
          <BookRow
            book={r.book}
            rank={i + 1}
            score={r.score}
            scoreLabel={String(r.score)}
            context={`śr. ${r.book.averageLabel}`}
          />
        ))
      }
    </ol>
  </main>

  <footer class="site-footer container">
    <hr class="divider" />
    <p><a class="foot-link" href={url('/')}>← Powrót do rankingu</a></p>
  </footer>
</Base>

<style>
  .leaderboard {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .site-footer .divider {
    margin-bottom: 1.5rem;
  }
  .crumb {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .crumb:hover {
    color: var(--ink);
  }
  .foot-link {
    font-weight: 600;
    color: var(--muted);
  }
  .foot-link:hover {
    color: var(--ink);
  }
</style>
