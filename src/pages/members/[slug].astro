---
import Base from '../../layouts/Base.astro';
import BookRow from '../../components/BookRow.astro';
import { getMembers, getMemberBySlug, getMemberRatingsChronological, getUserStatistics, getAllUserStatistics, getLeaderboard, booksLabel } from '../../data/books';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return getMembers().map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const member = getMemberBySlug(slug!);
if (!member) {
  return Astro.redirect(url('/404'), 302);
}

const stats = getUserStatistics(member.name);
const ratings = getMemberRatingsChronological(member.name);
const rankFor = (category: 'highest-average' | 'lowest-average' | 'streak' | 'activity') =>
  getLeaderboard(category).find((entry) => entry.user.name === member.name)?.rank;
const rankForScore = (score: number | null, direction: 'high' | 'low') => {
  if (score === null) return undefined;
  const values = getAllUserStatistics()
    .map((user) => direction === 'high' ? user.highestScore : user.lowestScore)
    .filter((value): value is number => value !== null)
    .sort((a, b) => direction === 'high' ? b - a : a - b);
  return values.findIndex((value) => value === score) + 1;
};
const medalClass = (rank: number | undefined) =>
  rank === 1 ? 'is-gold' : rank === 2 ? 'is-silver' : rank === 3 ? 'is-bronze' : '';
const medalEmoji = (rank: number | undefined) =>
  rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : null;
---

<Base title={`${member.name} — oceny — Klub Książki`}>
  <header class="site-header container">
    <p class="eyebrow"><a class="crumb" href={url('/')}>Klub Książki</a> · oceny członka</p>
    <h1 class="site-title">{stats.name}</h1>
  </header>

  <main class="container">
    <section class="member-stats" aria-labelledby="member-stats-heading">
      <h2 id="member-stats-heading" class="visually-hidden">Statystyki członka</h2>
      <div class:list={['member-stat-card', 'member-stat-count', medalClass(rankFor('activity'))]}>
        <span class="member-stat-icon" aria-hidden="true">📚</span>
        <span class="member-stat-label">Liczba książek</span>
        <strong class="member-stat-value">{stats.ratedCount} {medalEmoji(rankFor('activity'))}</strong>
      </div>
      <div class="member-stats-grid">
        <div class:list={['member-stat-card', medalClass(rankFor('streak'))]}>
          <span class="member-stat-icon" aria-hidden="true">🔥</span>
          <span class="member-stat-label">Najdłuższa seria</span>
          <strong class="member-stat-value">{stats.longestStreak} {medalEmoji(rankFor('streak'))}</strong>
          <span class="member-stat-unit">{booksLabel(stats.longestStreak)}</span>
        </div>
        <div class="member-stat-card">
          <span class="member-stat-icon" aria-hidden="true">📊</span>
          <span class="member-stat-label">Średnia ocena</span>
          <strong class="member-stat-value">{stats.averageLabel}</strong>
          {!stats.averageEligible && <span class="member-stat-note">poniżej 3 ocen</span>}
        </div>
        <div class:list={['member-stat-card', medalClass(rankForScore(stats.highestScore, 'high'))]}>
          <span class="member-stat-icon" aria-hidden="true">🏆</span>
          <span class="member-stat-label">Najwyższa ocena</span>
          <strong class="member-stat-value">{stats.highestScore ?? '—'} {medalEmoji(rankForScore(stats.highestScore, 'high'))}</strong>
        </div>
        <div class:list={['member-stat-card', medalClass(rankForScore(stats.lowestScore, 'low'))]}>
          <span class="member-stat-icon" aria-hidden="true">📉</span>
          <span class="member-stat-label">Najniższa ocena</span>
          <strong class="member-stat-value">{stats.lowestScore ?? '—'} {medalEmoji(rankForScore(stats.lowestScore, 'low'))}</strong>
        </div>
      </div>
    </section>

    <h2 class="history-title">Ocenione książki</h2>
    <ol class="leaderboard" role="list">
      {
        ratings.map((r, i) => (
          <BookRow
            book={r.book}
            rank={i + 1}
            score={r.score}
            scoreLabel={String(r.score)}
            context={`śr. ${r.book.averageLabel}`}
          />
        ))
      }
    </ol>
  </main>

  <footer class="site-footer container">
    <hr class="divider" />
    <p><a class="foot-link" href={url('/')}>← Powrót do rankingu</a></p>
  </footer>
</Base>

<style>
  .leaderboard {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .member-stats {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .member-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 11rem);
    gap: 0.65rem;
    justify-content: center;
  }
  .member-stat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    width: 11rem;
    aspect-ratio: 1;
    padding: 0.8rem;
    border: 4px solid var(--line-strong);
    border-radius: 1rem;
    background: var(--paper);
    box-shadow: 0 4px 14px rgba(35, 30, 22, 0.06);
  }
  .member-stat-card.is-gold {
    border-color: #d4a72c;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.18), var(--paper) 72%);
    box-shadow: 0 4px 16px rgba(212, 167, 44, 0.18);
  }
  .member-stat-card.is-silver {
    border-color: #87939f;
    background: linear-gradient(135deg, rgba(174, 184, 194, 0.2), var(--paper) 72%);
    box-shadow: 0 4px 16px rgba(174, 184, 194, 0.18);
  }
  .member-stat-card.is-bronze {
    border-color: #b66f3c;
    background: linear-gradient(135deg, rgba(196, 138, 98, 0.18), var(--paper) 72%);
    box-shadow: 0 4px 16px rgba(196, 138, 98, 0.18);
  }
  .member-stat-count {
    max-width: none;
    margin: 0 auto 1rem;
  }
  .member-stat-icon { font-size: 2.65rem; line-height: 1; }
  .member-stat-label { color: var(--muted); font-size: 0.82rem; }
  .member-stat-value {
    display: inline-flex;
    width: fit-content;
    margin-top: 0.15rem;
    padding: 0.18rem 0.65rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .member-stat-unit,
  .member-stat-note { color: var(--muted); font-size: 0.75rem; }
  .history-title { margin: 0 0 0.8rem; font-size: 1.35rem; }
  .site-footer .divider {
    margin-bottom: 1.5rem;
  }
  .crumb {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .crumb:hover {
    color: var(--ink);
  }
  .foot-link {
    font-weight: 600;
    color: var(--muted);
  }
  .foot-link:hover {
    color: var(--ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 38rem) {
    .member-stats-grid { grid-template-columns: repeat(2, 9.5rem); gap: 0.45rem; }
    .member-stat-card { width: 9.5rem; padding: 0.65rem; }
    .member-stat-icon { font-size: 2.2rem; }
    .member-stat-value { font-size: 1.1rem; }
  }
</style>
